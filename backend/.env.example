# ============================================================
# MatchArena backend — copy this file to `.env` and fill in.
#   cp .env.example .env
# NEVER commit .env — it holds your real secrets.
# ============================================================

# --- Server ---
HOST=127.0.0.1
PORT=8000
# Public origin of the site (used for cookies/CSRF origin checks).
# In production set https://your-domain.com
PUBLIC_ORIGIN=http://127.0.0.1:8000

# --- Secrets (CHANGE THESE — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
JWT_SECRET=CHANGE-ME-to-a-long-random-string
OTP_PEPPER=CHANGE-ME-to-another-long-random-string

# --- Sessions ---
ACCESS_TOKEN_MINUTES=15
REFRESH_DAYS=30

# --- Dev mode: OTP codes are printed to the server console instead of WhatsApp.
# ALSO returns the code in the API response. NEVER leave true in production. ---
DEV_MODE=true

# --- Google Sign-In (free: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, Web) ---
# Authorized JavaScript origin: http://127.0.0.1:8000  (and your production URL)
GOOGLE_CLIENT_ID=

# --- WhatsApp Cloud API (free API; ~1,000 free service conversations/month) ---
# developers.facebook.com -> Your app -> WhatsApp -> API Setup
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE=matcharena_otp          
WA_TEMPLATE_LANG=en

# NOTE: keep value lines plain KEY=VALUE — comments must be on their own line
# (the loader does not strip inline "# ..." from values).
# --- Email OTP / mail (free: Gmail app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Admin bootstrap (created on first start) ---
ADMIN_EMAIL=admin@matcharena.local
ADMIN_PASSWORD=CHANGE-ME-strong-pass

# --- Rate limits (per IP) ---
OTP_SEND_COOLDOWN_SECONDS=90
OTP_MAX_PER_DAY=5
LOGIN_MAX_PER_15MIN=10
